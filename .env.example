APP_NAME="G-Force Skydiving"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production + local default is MySQL 8+ (see SETUP.md "Production database").
# Create the DB/user first; never run migrate:fresh/refresh against production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thrill_seek
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only send the session cookie over HTTPS. Keep false for local/http dev;
# production over HTTPS MUST set this to true (see SETUP.md "Production security").
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SETTINGS_CACHE_ENABLED=true

# Resend (mail transport in production: set MAIL_MAILER=resend)
RESEND_API_KEY=
# Inbound email threading (see SETUP.md "Inbound email setup"): the receiving
# subdomain replies are addressed to, and the inbound webhook signing secret.
MAIL_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=

# Stripe (register the webhook URL /webhooks/stripe for checkout.session.completed)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Sentry error tracking (optional; leave the DSN blank to disable). PII is scrubbed
# before send (App\Support\SentryScrubber) and send_default_pii is off. Owner task:
# create a project at sentry.io and paste its DSN. See SETUP.md "Error tracking".
SENTRY_LARAVEL_DSN=
# Capture all errors (1.0); sample 20% of requests for performance tracing.
SENTRY_TRACES_SAMPLE_RATE=0.2
